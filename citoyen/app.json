      "**/*"
    ],
    "sdkVersion": "54.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kattanx.citizenportal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3b82f6"
      },
      "package": "com.kattanx.citizenportal"
    },
    "web": {
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
