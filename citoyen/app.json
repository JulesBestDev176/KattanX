{
  "expo": {
    "name": "KattanX - Portail Citoyen",
    "slug": "citizen-portal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#3b82f6"
    },
